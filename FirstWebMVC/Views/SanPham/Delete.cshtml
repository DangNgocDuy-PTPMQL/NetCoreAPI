@model FirstWebMVC.Models.Entities.SanPham

<div class="container mt-5">
    <div class="card shadow p-4 text-center">

        <h3 class="text-danger">⚠ Bạn có chắc muốn xóa?</h3>

        <p class="mt-3">
            Sản phẩm: <strong>@Model.Ten</strong>
        </p>

        <form method="post" asp-action="DeleteConfirmed">
            <input type="hidden" asp-for="Id" />

            <button class="btn btn-danger">🗑 Xóa</button>
            <a href="/SanPham" class="btn btn-secondary">⬅ Hủy</a>
        </form>

    </div>
</div>