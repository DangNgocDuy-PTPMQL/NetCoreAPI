@model List<FirstWebMVC.Models.Entities.SanPham>

<div class="container mt-4">

    <h2 class="mb-4 text-center">🛍️ Danh sách sản phẩm</h2>

    <a href="/SanPham/Create" class="btn btn-primary mb-3">
        ➕ Thêm sản phẩm
    </a>

    <table class="table table-striped table-hover shadow">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Tên sản phẩm</th>
                <th>Giá</th>
                <th>Hành động</th>
            </tr>
        </thead>

        <tbody>
@foreach (var item in Model)
{
            <tr>
                <td>@item.Id</td>
                <td>@item.Ten</td>
                <td class="text-danger">@item.Gia.ToString("N0") đ</td>
                <td>
                    <a href="/SanPham/Edit/@item.Id" class="btn btn-warning btn-sm">✏</a>
                    <a href="/SanPham/Delete/@item.Id" class="btn btn-danger btn-sm">🗑</a>
                </td>
            </tr>
}
        </tbody>
    </table>

</div>