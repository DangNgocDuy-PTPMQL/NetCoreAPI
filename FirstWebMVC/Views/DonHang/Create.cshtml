@model FirstWebMVC.Models.Entities.DonHang

<div class="container mt-5">
    <div class="card shadow-lg p-4">
        <h2 class="text-center mb-4">🧾 Thêm đơn hàng</h2>

        <form method="post">

            <div class="mb-3">
                <label class="form-label">Ngày đặt</label>
                <input asp-for="NgayDat" type="date" class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label">Khách hàng</label>
                <select asp-for="KhachHangId" class="form-select">
                    @foreach (var kh in ViewBag.KhachHangs)
                    {
                        <option value="@kh.Id">@kh.Ten</option>
                    }
                </select>
            </div>

            <div class="d-flex justify-content-between">
                <a href="/DonHang" class="btn btn-secondary">⬅ Quay lại</a>
                <button type="submit" class="btn btn-success">💾 Lưu</button>
            </div>

        </form>
    </div>
</div>