@model List<FirstWebMVC.Models.Entities.DonHang>

<div class="container mt-4">

    <h2 class="mb-4 text-center">📦 Đơn hàng của khách</h2>

    @foreach (var dh in Model)
    {
        <div class="card mb-4 shadow">
            <div class="card-header bg-primary text-white">
                <strong>Đơn hàng #@dh.Id</strong> - @dh.NgayDat.ToString("dd/MM/yyyy")
            </div>

            <div class="card-body">

                <table class="table table-bordered table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Sản phẩm</th>
                            <th>Giá</th>
                            <th>Số lượng</th>
                            <th>Thành tiền</th>
                        </tr>
                    </thead>

                    <tbody>
                        @{
                            decimal tong = 0;
                        }

                        @foreach (var ct in dh.ChiTietDonHangs ?? new List<FirstWebMVC.Models.Entities.ChiTietDonHang>())
                        {
                            var thanhTien = (ct.SanPham?.Gia ?? 0) * ct.SoLuong;
                            tong += thanhTien;

                            <tr>
                                <td>@ct.SanPham?.Ten</td>
                                <td>@ct.SanPham?.Gia</td>
                                <td>@ct.SoLuong</td>
                                <td>@thanhTien</td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div class="text-end">
                    <strong>Tổng tiền: </strong>
                    <span class="text-danger">@tong</span>
                </div>

            </div>
        </div>
    }

    <a href="/KhachHang" class="btn btn-secondary">⬅ Quay lại</a>

</div>