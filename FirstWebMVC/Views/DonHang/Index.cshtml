@model List<FirstWebMVC.Models.Entities.DonHang>
<h2 class="mb-4 text-center">📋 Danh sách</h2>

<div class="container">
    <a href="/KhachHang/Create" class="btn btn-primary mb-3">
        ➕ Thêm mới
    </a>

    <table class="table table-striped table-hover shadow">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Tên</th>
                <th>Email</th>
                <th>Hành động</th>
            </tr>
        </thead>

        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.KhachHang?.Ten</td>
                <td>@item.KhachHang?.Email</td> 
                <td>
                    <a class="btn btn-warning btn-sm">✏</a>
                    <a class="btn btn-danger btn-sm">🗑</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

