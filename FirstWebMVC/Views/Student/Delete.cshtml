@model FirstWebMVC.Models.Entities.Student

<h3 class="text-danger">⚠ Bạn có chắc muốn xóa sinh viên?</h3>

<p>
    <strong>@Model.FullName</strong> - @Model.StudentCode
</p>

<form method="post" asp-action="DeleteConfirmed" asp-controller="Student">
    <input type="hidden" asp-for="Id" />

    <button type="submit" class="btn btn-danger">🗑 Xóa</button>
    <a href="/Student" class="btn btn-secondary">⬅ Hủy</a>
</form> 