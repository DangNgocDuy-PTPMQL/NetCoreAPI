@model List<FirstWebMVC.Models.ViewModels.StudentVM>
<h2>Danh sách sinh viên</h2>

<p>
    <a asp-controller="Student" asp-action="Create">Thêm sinh viên</a>
</p>

<table border="1" cellpadding="5" cellspacing="0">
    <thead>
        <tr>
            <th>Mã SV</th>
            <th>Họ tên</th>
            <th>Lớp</th> <!-- ✅ THÊM -->
            <th>Chức năng</th>
        </tr>
    </thead>

    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.StudentCode</td>
            <td>@item.FullName</td>

            <td>@item.FacultyName</td>

            <td>
                <a asp-controller="Student" asp-action="Edit" asp-route-id="@item.Id">Sửa</a> |
                <a asp-controller="Student" asp-action="Delete" asp-route-id="@item.Id">Xóa</a>
            </td>
        </tr>
    }
    </tbody>
</table>